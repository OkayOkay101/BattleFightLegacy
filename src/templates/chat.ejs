<!-- chat input field -->
<div id="chat-input-field-div" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%)">
    <div class="form-group" id="chat-message-input" style="display: none">
        <div class="input-group d-flex justify-content-center">
            <form class="mb-0" onsubmit="ige.chat.sendChatMessage(); return false">
                <input type="text" class="form-control btn-sm" id="message" placeholder="Type a message..." data-i18n-placeholder="chat.placeholder" />
            </form>
            <div class="input-group-append" onclick="ige.chat.sendChatMessage()">
                <button class="btn btn-secondary" type="button">
                    <i class="fa fa-comment"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- chat box -->
<div id="chat-box" class="game-ui" style="bottom: 0; display: none">
    <div id="chat-tab-container" class="hide-on-mobile d-flex flex-column">
        <ul id="tabs" class="nav nav-pills no-selection">
            <li class="nav-item">
                <a id="hide-chat" class="cursor-pointer hide-on-mobile pr-0 nav-link" style="position: absolute; right: 0;" data-i18n="chat.hide"> Hide </a>
            </li>
        </ul>
        <div class="tab-content flex-grow-1 d-flex">
            <div class="tab-pane fade show active w-100" id="pills-chat" role="tabpanel" aria-labelledby="pills-chat-tab">
                <div class="h-100 w-100 p-2">
                    <div id="chat-history" class="hide-on-mobile h-100" style="max-height: 170px; overflow: auto;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var chatFadeTimer = null;
    function wakeChat() {
        var box = document.getElementById('chat-box');
        if (!box) return;
        box.classList.remove('bf-chat-faded');
        if (chatFadeTimer) clearTimeout(chatFadeTimer);
        chatFadeTimer = setTimeout(function () {
            if (box) box.classList.add('bf-chat-faded');
        }, 6000);
    }
    document.addEventListener('DOMContentLoaded', function () {
        var history = document.getElementById('chat-history');
        if (history && typeof MutationObserver !== 'undefined') {
            new MutationObserver(wakeChat).observe(history, { childList: true, subtree: true });
        }
        wakeChat();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') wakeChat();
    });
})();
</script>

<!-- show/hide chat button -->
<div id="show-chat" class="btn btn-success d-none position-absolute" style="bottom: 10">
    <i class="fa fa-comment mr-1"></i>
    <span data-i18n="chat.show">Show Chat</span>
</div>
