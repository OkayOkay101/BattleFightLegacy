<!-- play button -->
<div id="play-game-button-wrapper" class="h-100 w-100 d-flex justify-content-center position-absolute align-items-center d-none-important">
    <% if (trainingDemoPolicy) { %>
    <div id="training-demo-settings" data-policy="<%= trainingDemoPolicy %>">
        <span class="demo-kicker">BATTLEFIGHT · TRAINED AI</span>
        <h2>สนามทดลองบอท</h2>
        <p>ดูบอทฝึก 3 ต่อ 3 หรือเข้าร่วมทีมฟ้าเพื่อต่อสู้กับทีมแดง</p>
        <div class="demo-policy">รุ่นบอท: <strong><%= trainingDemoPolicy %></strong> · แมตช์นี้ไม่บันทึกเป็นผลการฝึก</div>
        <div class="demo-options" role="radiogroup" aria-label="โหมดทดลอง">
            <label><input type="radio" name="training-demo-mode" value="spectate" checked><span><strong>ดูบอทสู้</strong><small>ชมการต่อสู้และสลับมุมกล้อง</small></span></label>
            <label><input type="radio" name="training-demo-mode" value="fight"><span><strong>ลงสู้เอง</strong><small>เลือกตัวละครแล้วร่วมทีมฟ้า</small></span></label>
        </div>
    </div>
    <% } %>
    <button id="play-game-button" type="button" class="btn btn-success" data-style="rotate-side-down" data-perspective data-horizontal>
        <div class="bg-success rounded">
            <i class="fa fa-gamepad pr-2 py-3" aria-hidden="true"></i>
            Play Game
        </div>
    </button>
</div>
<% if (trainingDemoPolicy) { %>
<div id="training-demo-spectator" hidden aria-live="polite">
    <span id="training-demo-following">กำลังรอบอทลงสนาม…</span>
    <button type="button" id="training-demo-next">ดูกล้องตัวถัดไป</button>
    <button type="button" id="training-demo-exit">เปลี่ยนโหมด</button>
</div>
<style>
#play-game-button-wrapper:has(#training-demo-settings) { flex-direction: column; gap: 1rem; background: linear-gradient(145deg,rgba(14,26,48,.82),rgba(10,16,31,.68)); z-index: 100; }
#training-demo-settings { width: min(92vw,620px); padding: 26px; border: 1px solid #9dc6e5; border-radius: 20px; background: #f5f8fd; color: #14263e; box-shadow: 0 18px 55px #07132488; }
#training-demo-settings h2 { font-size: clamp(1.5rem,4vw,2.1rem); margin: .25rem 0; font-weight: 800; }
#training-demo-settings p { margin: .25rem 0 1rem; color: #425673; }
#training-demo-settings .demo-kicker { font-size: .72rem; letter-spacing: .17em; color: #176bb3; font-weight: 800; }
#training-demo-settings .demo-policy { background: #e7f1fc; border-radius: 9px; padding: .6rem .8rem; font-size: .86rem; }
#training-demo-settings .demo-options { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; margin-top: 1rem; }
#training-demo-settings .demo-options label { cursor: pointer; margin: 0; }
#training-demo-settings .demo-options input { position: absolute; opacity: 0; }
#training-demo-settings .demo-options span { display: flex; flex-direction: column; gap: .25rem; min-height: 85px; padding: 1rem; border: 2px solid #c6d7e9; border-radius: 12px; background: white; }
#training-demo-settings .demo-options small { color: #52647b; }
#training-demo-settings .demo-options input:checked + span { border-color: #0869c2; background: #eaf4ff; box-shadow: inset 0 0 0 1px #0869c2; }
#training-demo-settings .demo-options input:focus-visible + span, #training-demo-spectator button:focus-visible { outline: 3px solid #f3a428; outline-offset: 3px; }
#training-demo-spectator { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); z-index: 50; display: flex; align-items: center; gap: .65rem; max-width: 95vw; padding: .5rem .8rem; border-radius: 11px; background: #f5f8fdef; color: #14263e; box-shadow: 0 4px 22px #07132477; }
#training-demo-spectator[hidden] { display: none; }
#training-demo-spectator button { border: 0; border-radius: 7px; background: #176bb3; color: white; padding: .45rem .65rem; }
#game-div:has(#training-demo-spectator:not([hidden])) #counter { top: 68px; }
@media (max-width: 520px) { #training-demo-settings { padding: 17px; } #training-demo-settings .demo-options { grid-template-columns: 1fr; } #training-demo-spectator { flex-wrap: wrap; justify-content: center; width: 95vw; } #game-div:has(#training-demo-spectator:not([hidden])) #counter { top: 112px; } }
</style>
<script>
window.trainingDemoMode = 'spectate';
document.addEventListener('DOMContentLoaded', function () {
    var settings = document.getElementById('training-demo-settings');
    if (!settings) return;
    settings.addEventListener('change', function (event) {
        if (event.target.name === 'training-demo-mode') window.trainingDemoMode = event.target.value;
    });
    document.getElementById('play-game-button').addEventListener('click', function () {
        if (window.trainingDemoMode === 'spectate') document.getElementById('training-demo-spectator').hidden = false;
    });
    document.getElementById('training-demo-exit').addEventListener('click', function () { window.location.reload(); });
    var followedIndex = 0;
    var followedUnit = null;
    var cameraTickerAttached = false;
    document.getElementById('training-demo-next').addEventListener('click', function () { followedIndex++; });
    window.setInterval(function () {
        if (window.trainingDemoMode !== 'spectate' || !window.joinedGame || !window.ige || !ige.game || !ige.client || !ige.pixi) return;
        if (!cameraTickerAttached && ige.pixi.ticker && ige.pixi.viewport) {
            cameraTickerAttached = true;
            ige.pixi.viewport.removePlugin('follow');
            ige.pixi.ticker.add(function () {
                if (!followedUnit || !ige.pixi.viewport) return;
                if (ige.pixi.viewport.plugins.follow) ige.pixi.viewport.removePlugin('follow');
                var position = followedUnit._pixiContainer && !followedUnit._pixiContainer._destroyed
                    ? followedUnit._pixiContainer : followedUnit._translate;
                if (position && Number.isFinite(position.x) && Number.isFinite(position.y)) {
                    ige.pixi.viewport.moveCenter(position.x, position.y);
                }
            });
        }
        var bots = ige.$$('unit').filter(function (unit) {
            var owner = unit.getOwner && unit.getOwner();
            return owner && owner._stats && owner._stats.isBattleBot && owner.getSelectedUnit &&
                owner.getSelectedUnit() === unit && unit._stats.attributes && unit._stats.attributes.health &&
                unit._stats.attributes.health.value > 0 && unit._pixiContainer;
        });
        if (!bots.length) {
            followedUnit = null;
            document.getElementById('training-demo-following').textContent = 'กำลังรอบอทลงสนาม…';
            return;
        }
        followedUnit = bots[followedIndex % bots.length];
        document.getElementById('training-demo-following').textContent = 'กำลังดู: ' + (followedUnit._stats.name || 'บอท');
    }, 100);
});
</script>
<% } %>
